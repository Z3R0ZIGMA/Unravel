<Project>
  <!-- Shared settings for every project in the solution (same as Unveil). -->
  <PropertyGroup>
    <!-- 10.0.19041 for the Windows Runtime API used to list Store apps (PackageManager). Runs on Windows 10 1809+. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>embedded</DebugType>
    <Company>Unravel</Company>
    <Product>Unravel</Product>
    <Version>0.4.0</Version>
  </PropertyGroup>
</Project>
