<Project>
  <!-- Shared settings for every project in the solution (same as Unveil). -->
  <PropertyGroup>
    <!-- 10.0.19041 for the Windows Runtime API used to list Store apps (PackageManager). Runs on Windows 10 1809+. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>embedded</DebugType>
    <!-- Version information shown in the exe's Properties > Details and in Task Manager. -->
    <Company>Unravel</Company>
    <Product>Unravel</Product>
    <AssemblyTitle>Unravel</AssemblyTitle>
    <Description>Everything about this PC: hardware, Windows, software, security and diagnostics, with reports.</Description>
    <Copyright>Copyright (c) 2026 Z3R0</Copyright>
    <RepositoryUrl>https://github.com/Z3R0ZIGMA/Unravel</RepositoryUrl>
    <Version>0.6.4</Version>
  </PropertyGroup>
</Project>
