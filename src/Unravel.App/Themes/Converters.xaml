<!-- Value converters, in their own dictionary so other dictionaries (Views/CardTemplates.xaml) can merge them. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Unravel.App.Converters">
    <conv:SeverityToBrushConverter x:Key="SeverityBrush" />
    <conv:SeverityToGlyphConverter x:Key="SeverityGlyph" />
    <conv:TileStateToBrushConverter x:Key="TileStateBrush" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <conv:UpperConverter x:Key="Upper" />
    <conv:EnumEqualsConverter x:Key="EnumEquals" />
    <conv:EnumToVisibilityConverter x:Key="EnumToVis" />
    <conv:SizeConverter x:Key="Size" />
    <conv:DateOnlyConverter x:Key="DateOnly" />
    <conv:NotConverter x:Key="Not" />
</ResourceDictionary>
