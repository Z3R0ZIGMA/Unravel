<UserControl x:Class="Unravel.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Unravel.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <UserControl.Resources>
        <!-- Shared layout of one active test: what it does, Run / Cancel, progress, result. -->
        <DataTemplate x:Key="TestBody" DataType="{x:Type vm:ActiveTestViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,0,0,10" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Run" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}" MinWidth="80" Margin="0,0,8,0" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="80"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="Needs administrator rights: use Restart as administrator." Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" Margin="4,0,0,0"
                               Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" Margin="0,4,0,6">
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" Maximum="100" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}"
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                <TextBox Text="{Binding Log, Mode=OneWay}" Style="{StaticResource ValueText}" FontFamily="Cascadia Mono, Consolas"
                         FontSize="12" MaxHeight="220" Margin="0,6,0,6" Padding="10,8" Background="{StaticResource Window}"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="ScrollLogToEnd"
                         Visibility="{Binding HasLog, Converter={StaticResource BoolToVis}}">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius}" Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                            </Border>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>

                <ContentControl Content="{Binding Outcome}" Visibility="{Binding Outcome, Converter={StaticResource NullToCollapsed}}" Focusable="False">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource IconText}" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0"
                                           Text="{Binding Severity, Converter={StaticResource SeverityGlyph}}"
                                           Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                <StackPanel Grid.Column="1">
                                    <TextBox Text="{Binding Summary, Mode=OneWay}" Style="{StaticResource ValueText}" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding Details}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Mode=OneWay}" Style="{StaticResource MutedValueText}" Margin="0,2,0,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Diagnostics" Style="{StaticResource TitleText}" Margin="2,0,0,14" />

        <ItemsControl ItemsSource="{Binding DiagnosticsCards}" ItemTemplate="{StaticResource CardTemplate}" Focusable="False" />

        <TextBlock Text="Active tests" Style="{StaticResource TitleText}" FontSize="19" Margin="2,10,0,4" />
        <TextBlock Text="Nothing runs until you click Run. Each test says first what it will do." Style="{StaticResource MutedText}" Margin="2,0,0,14" />

        <!-- Disk speed -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="File size" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding DiskTestSizes}" SelectedItem="{Binding DiskTestSizeMb}" Width="90"
                                  IsEnabled="{Binding DiskTest.IsRunning, Converter={StaticResource Not}}" />
                        <TextBlock Text="MB" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding DiskTest.Title}" Style="{StaticResource HeadingText}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <ContentControl Content="{Binding DiskTest}" ContentTemplate="{StaticResource TestBody}" Focusable="False" />
            </StackPanel>
        </Border>

        <!-- Network -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <CheckBox DockPanel.Dock="Right" Content="Include a 25 MB download test" IsChecked="{Binding NetworkDownload}" VerticalAlignment="Center"
                              IsEnabled="{Binding NetworkTest.IsRunning, Converter={StaticResource Not}}" />
                    <TextBlock Text="{Binding NetworkTest.Title}" Style="{StaticResource HeadingText}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <ContentControl Content="{Binding NetworkTest}" ContentTemplate="{StaticResource TestBody}" Focusable="False" />
            </StackPanel>
        </Border>

        <!-- CPU stress -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="Duration" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding CpuTestDurations}" SelectedItem="{Binding CpuTestSeconds}" Width="70"
                                  IsEnabled="{Binding CpuTest.IsRunning, Converter={StaticResource Not}}" />
                        <TextBlock Text="s" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding CpuTest.Title}" Style="{StaticResource HeadingText}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <ContentControl Content="{Binding CpuTest}" ContentTemplate="{StaticResource TestBody}" Focusable="False" />
            </StackPanel>
        </Border>

        <!-- Memory -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Memory" Style="{StaticResource HeadingText}" />
                <TextBlock Text="{Binding MemoryTestDescription}" Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Open Windows Memory Diagnostic" Command="{Binding OpenMemoryDiagnosticCommand}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding MemoryTestLastResult}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- sfc / DISM -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{Binding SystemFilesTest.Title}" Style="{StaticResource HeadingText}" />
                <ContentControl Content="{Binding SystemFilesTest}" ContentTemplate="{StaticResource TestBody}" Focusable="False" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
