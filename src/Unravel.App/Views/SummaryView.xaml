<UserControl x:Class="Unravel.App.Views.SummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Unravel.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <UserControl.Resources>
        <!-- A label / value list (Processor, Windows). Values are selectable. -->
        <DataTemplate x:Key="FieldRow">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" VerticalAlignment="Top" />
                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource ValueText}" />
                <Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Copy" Margin="6,-4,0,-4"
                        Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Value}"
                        Visibility="{Binding Copyable, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" FontSize="13" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <!-- ============================================ header: make + model, name, serial -->
        <Border Style="{StaticResource Card}" Padding="22,18">
            <StackPanel>
                <TextBox Text="{Binding Summary.Title, Mode=OneWay}" Style="{StaticResource ValueText}"
                         FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" />
                <TextBox Text="{Binding Summary.Subtitle, Mode=OneWay}" Style="{StaticResource MutedValueText}" FontSize="14" Margin="0,2,0,0"
                         Visibility="{Binding Summary.Subtitle, Converter={StaticResource NullToCollapsed}}" />

                <ItemsControl ItemsSource="{Binding Summary.Identity}" Margin="0,14,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,36,6" MinWidth="150">
                                <TextBlock Text="{Binding Label, Converter={StaticResource Upper}}" Style="{StaticResource CapsLabel}" Margin="0,0,0,3" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding Value, Mode=OneWay}" Style="{StaticResource ValueText}" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource IconButton}" ToolTip="Copy" Margin="4,-4,0,-4"
                                            Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Value}"
                                            Visibility="{Binding Copyable, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" FontSize="13" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ============================================ key specs: CPU · RAM · Storage · OS · Uptime -->
        <ItemsControl ItemsSource="{Binding Summary.Specs}" Margin="0,0,-12,0" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="5" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Tile}" ToolTip="{Binding ToolTip}" ToolTipService.IsEnabled="{Binding ToolTip, Converter={StaticResource NullToCollapsed}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Label, Converter={StaticResource Upper}}" Style="{StaticResource CapsLabel}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="44"
                                       TextTrimming="CharacterEllipsis" Foreground="{Binding State, Converter={StaticResource TileStateBrush}}" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ============================================ health strip -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Health" Style="{StaticResource HeadingText}" />
                <ItemsControl ItemsSource="{Binding Summary.Health}" Margin="0,0,-10,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Window}" CornerRadius="{StaticResource Radius}" Padding="12,10" Margin="0,0,10,0"
                                    Cursor="Help" ToolTip="{Binding ToolTip}" ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="30000"
                                    ToolTipService.IsEnabled="{Binding ToolTip, Converter={StaticResource NullToCollapsed}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource IconText}" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"
                                               Text="{Binding Severity, Converter={StaticResource SeverityGlyph}}"
                                               Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Area}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding Text}" Style="{StaticResource MutedText}" FontSize="12" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ============================================ processor | windows -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Processor" Style="{StaticResource HeadingText}" />
                    <ItemsControl ItemsSource="{Binding Summary.Processor}" ItemTemplate="{StaticResource FieldRow}" Focusable="False" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Windows" Style="{StaticResource HeadingText}" />
                    <ItemsControl ItemsSource="{Binding Summary.Windows}" ItemTemplate="{StaticResource FieldRow}" Focusable="False" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================ memory -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Memory" Style="{StaticResource HeadingText}" />
                <TextBox Text="{Binding Summary.MemorySummary, Mode=OneWay}" Style="{StaticResource ValueText}"
                         Visibility="{Binding Summary.MemorySummary, Converter={StaticResource NullToCollapsed}}" />
                <TextBlock Text="{Binding Summary.MemoryUpgrade}" Style="{StaticResource MutedText}" Margin="0,2,0,10"
                           Visibility="{Binding Summary.MemoryUpgrade, Converter={StaticResource NullToCollapsed}}" />

                <Grid Grid.IsSharedSizeScope="True" Margin="0,6,0,0"
                      Visibility="{Binding Summary.HasModules, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="Slot" MinWidth="120" />
                            <ColumnDefinition SharedSizeGroup="Size" MinWidth="70" />
                            <ColumnDefinition SharedSizeGroup="Gen" MinWidth="110" />
                            <ColumnDefinition SharedSizeGroup="Speed" MinWidth="140" />
                            <ColumnDefinition SharedSizeGroup="Form" MinWidth="90" />
                            <ColumnDefinition SharedSizeGroup="Make" MinWidth="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SLOT" Style="{StaticResource CapsLabel}" />
                        <TextBlock Grid.Column="1" Text="SIZE" Style="{StaticResource CapsLabel}" />
                        <TextBlock Grid.Column="2" Text="TYPE" Style="{StaticResource CapsLabel}" />
                        <TextBlock Grid.Column="3" Text="SPEED" Style="{StaticResource CapsLabel}" />
                        <TextBlock Grid.Column="4" Text="FORM" Style="{StaticResource CapsLabel}" />
                        <TextBlock Grid.Column="5" Text="MAKER" Style="{StaticResource CapsLabel}" />
                        <TextBlock Grid.Column="6" Text="PART NUMBER" Style="{StaticResource CapsLabel}" />
                    </Grid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Summary.Modules}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition SharedSizeGroup="Slot" />
                                            <ColumnDefinition SharedSizeGroup="Size" />
                                            <ColumnDefinition SharedSizeGroup="Gen" />
                                            <ColumnDefinition SharedSizeGroup="Speed" />
                                            <ColumnDefinition SharedSizeGroup="Form" />
                                            <ColumnDefinition SharedSizeGroup="Make" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding Slot, Mode=OneWay}" Style="{StaticResource ValueText}" Margin="0,0,12,0" />
                                        <TextBox Grid.Column="1" Text="{Binding Size, Mode=OneWay}" Style="{StaticResource ValueText}" Margin="0,0,12,0" />
                                        <TextBox Grid.Column="2" Text="{Binding Generation, Mode=OneWay}" Style="{StaticResource ValueText}" Margin="0,0,12,0" />
                                        <TextBox Grid.Column="3" Text="{Binding Speed, Mode=OneWay}" Style="{StaticResource ValueText}" Margin="0,0,12,0" />
                                        <TextBox Grid.Column="4" Text="{Binding FormFactor, Mode=OneWay}" Style="{StaticResource ValueText}" Margin="0,0,12,0" />
                                        <TextBox Grid.Column="5" Text="{Binding Manufacturer, Mode=OneWay}" Style="{StaticResource ValueText}" Margin="0,0,12,0" />
                                        <TextBox Grid.Column="6" Text="{Binding PartNumber, Mode=OneWay}" Style="{StaticResource ValueText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============================================ storage -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Storage" Style="{StaticResource HeadingText}" />

                <!-- volumes with a usage bar -->
                <ItemsControl ItemsSource="{Binding Summary.Volumes}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Letter}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Style="{StaticResource MutedText}" />
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </DockPanel>
                                    <ProgressBar Value="{Binding PercentUsed, Mode=OneWay}" Maximum="100" Margin="0,6,0,0"
                                                 Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- physical disks -->
                <ItemsControl ItemsSource="{Binding Summary.Disks}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBox Text="{Binding Title, Mode=OneWay}" Style="{StaticResource ValueText}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                    Visibility="{Binding SerialNumber, Converter={StaticResource NullToCollapsed}}">
                                            <TextBlock Text="Serial " Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                            <TextBox Text="{Binding SerialNumber, Mode=OneWay}" Style="{StaticResource MutedValueText}" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource IconButton}" ToolTip="Copy serial number" Margin="4,-4,0,-4"
                                                    Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding SerialNumber}">
                                                <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <TextBlock Style="{StaticResource IconText}" Margin="0,0,6,0"
                                                   Text="{Binding Health, Converter={StaticResource SeverityGlyph}}"
                                                   Foreground="{Binding Health, Converter={StaticResource SeverityBrush}}" />
                                        <TextBlock Text="{Binding HealthText}" Style="{StaticResource BodyText}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ============================================ data notes: what could not be read -->
        <Border Style="{StaticResource Card}" Visibility="{Binding HasDataNotes, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Data notes" Style="{StaticResource HeadingText}" />
                <ItemsControl ItemsSource="{Binding Summary.DataNotes}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE946;" Foreground="{StaticResource Muted}" Margin="0,0,10,0" />
                                <TextBox Text="{Binding Mode=OneWay}" Style="{StaticResource MutedValueText}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ============================================ findings (at the bottom, after the details) -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Findings" Style="{StaticResource HeadingText}" />
                <TextBlock Text="No problems found in the checks so far." Style="{StaticResource MutedText}"
                           Visibility="{Binding HasFindings, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                <ItemsControl ItemsSource="{Binding Summary.Findings}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource IconText}" FontSize="16" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0"
                                           Text="{Binding Severity, Converter={StaticResource SeverityGlyph}}"
                                           Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                <StackPanel Grid.Column="1">
                                    <TextBox Text="{Binding Message, Mode=OneWay}" Style="{StaticResource ValueText}" />
                                    <TextBlock Text="{Binding Recommendation}" Style="{StaticResource MutedText}" Margin="0,2,0,0"
                                               Visibility="{Binding Recommendation, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
