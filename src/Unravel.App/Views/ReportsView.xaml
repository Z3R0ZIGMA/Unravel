<UserControl x:Class="Unravel.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Unravel.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <!-- The Reports page (plan.md section 6): details for the report, redaction, and the four exports. -->
    <StackPanel MaxWidth="980" HorizontalAlignment="Left">
        <TextBlock Text="Reports" Style="{StaticResource TitleText}" Margin="2,0,0,14" />

        <!-- Report details -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Report details" Style="{StaticResource HeadingText}" Margin="0,0,0,4" />
                <TextBlock Text="Optional. Shown at the top of the HTML and PDF report, and saved in the JSON." Style="{StaticResource MutedText}" Margin="0,0,0,14" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Client name" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Style="{StaticResource SearchBox}" Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}"
                             Width="420" HorizontalAlignment="Left" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="1" Text="Ticket number" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource SearchBox}" Text="{Binding TicketNumber, UpdateSourceTrigger=PropertyChanged}"
                             Width="420" HorizontalAlignment="Left" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="2" Text="Technician notes" Style="{StaticResource MutedText}" VerticalAlignment="Top" Margin="0,8,0,0" />
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource MultiLineBox}" Text="{Binding TechnicianNotes, UpdateSourceTrigger=PropertyChanged}"
                             Height="130" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Privacy -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Privacy" Style="{StaticResource HeadingText}" Margin="0,0,0,10" />
                <CheckBox Content="Redact sensitive fields" IsChecked="{Binding RedactReport}" />
                <TextBlock Text="{Binding RedactionDescription}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="28,6,0,0" />
                <TextBlock Text="Use it for reports that go to a third party. Applies to all four exports." Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" Margin="28,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Export -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Export" Style="{StaticResource HeadingText}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding ActiveTestsInReport}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,14" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button Content="Save HTML report" Command="{Binding SaveHtmlCommand}" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch" Margin="0,0,16,10" />
                    <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,0,10"
                               Text="One file that opens in any browser and prints cleanly: the summary, every section, the health checks, active test results and your notes." />

                    <Button Grid.Row="1" Content="Save PDF" Command="{Binding SavePdfCommand}" HorizontalAlignment="Stretch" Margin="0,0,16,10" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,0,10"
                               Text="The same report as a PDF, to attach to a ticket or an e-mail." />

                    <Button Grid.Row="2" Content="Save JSON data" Command="{Binding SaveJsonCommand}" HorizontalAlignment="Stretch" Margin="0,0,16,10" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,0,10"
                               Text="Everything Unravel read, in a versioned format: keep it to compare this PC later." />

                    <Button Grid.Row="3" Content="Save software list (CSV)" Command="{Binding SaveCsvCommand}" HorizontalAlignment="Stretch" Margin="0,0,16,0" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="Installed programs and Store apps with versions and publishers, for Excel." />
                </Grid>

                <!-- Result of the last export -->
                <DockPanel Margin="0,16,0,0" Visibility="{Binding ExportMessage, Converter={StaticResource NullToCollapsed}}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                                Visibility="{Binding HasLastExport, Converter={StaticResource BoolToVis}}">
                        <Button Content="Open" Command="{Binding OpenExportCommand}" Margin="12,0,8,0" />
                        <Button Content="Show in folder" Command="{Binding ShowExportCommand}" />
                    </StackPanel>
                    <TextBox Text="{Binding ExportMessage, Mode=OneWay}" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
