<UserControl x:Class="Unravel.App.Views.SoftwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Unravel.App.ViewModels"
             xmlns:local="clr-namespace:Unravel.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <!-- Software catalogue (plan.md 4.5): highlights, then a searchable, sortable list. -->
    <StackPanel>
        <TextBlock Text="Software" Style="{StaticResource TitleText}" Margin="2,0,0,14" />

        <ItemsControl ItemsSource="{Binding SoftwareHighlights}" ItemTemplate="{StaticResource CardTemplate}" Focusable="False" />

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SoftwareCount}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    <TextBlock Text="Installed software" Style="{StaticResource HeadingText}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>

                <WrapPanel Margin="0,0,0,12">
                    <Grid Width="320" Margin="0,0,20,6">
                        <TextBox x:Name="Search" Style="{StaticResource SearchBox}" Text="{Binding SoftwareSearch, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search by name, publisher or version" />
                        <TextBlock Text="Search name, publisher, version" Style="{StaticResource MutedText}" IsHitTestVisible="False"
                                   Margin="12,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding SoftwareSearch, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}" />
                    </Grid>
                    <CheckBox Content="Store apps" IsChecked="{Binding ShowStoreApps}" Margin="0,0,20,6" VerticalAlignment="Center" />
                    <CheckBox Content="Updates and system components" IsChecked="{Binding ShowHiddenEntries}" Margin="0,0,20,6" VerticalAlignment="Center"
                              ToolTip="Entries Programs and Features also hides" />
                    <CheckBox Content="Store frameworks and Windows apps" IsChecked="{Binding ShowSystemPackages}" Margin="0,0,20,6" VerticalAlignment="Center"
                              ToolTip="Runtime packages (VCLibs, .NET) and Windows' built-in apps" />
                </WrapPanel>

                <DataGrid ItemsSource="{Binding SoftwareView}" local:WheelToParent.Enabled="True" CanUserSortColumns="True"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" ClipboardCopyMode="IncludeHeader">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="0.7*" />
                        <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1.2*" />
                        <DataGridTextColumn Header="Installed" Binding="{Binding InstallDate, Converter={StaticResource DateOnly}}"
                                            SortMemberPath="InstallDate" Width="96" />
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes, Converter={StaticResource Size}}" SortMemberPath="SizeBytes"
                                            Width="70" ElementStyle="{StaticResource RightText}" />
                        <DataGridTextColumn Header="Arch." Binding="{Binding Architecture}" Width="64" />
                        <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="72" />
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="72" />
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="ToolTip" Value="{Binding UninstallString}" />
                            <Setter Property="ToolTipService.IsEnabled" Value="{Binding UninstallString, Converter={StaticResource NullToCollapsed}}" />
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
