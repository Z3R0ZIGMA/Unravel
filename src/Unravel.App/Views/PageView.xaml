<UserControl x:Class="Unravel.App.Views.PageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:Unravel.Core.Pages;assembly=Unravel.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pages:PageModel}">
    <!-- One page (Device, Hardware, OS, Security): a title and its cards. DataContext is a PageModel. -->
    <StackPanel>
        <StackPanel Margin="2,0,0,14">
            <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}" />
            <TextBox Text="{Binding Subtitle, Mode=OneWay}" Style="{StaticResource MutedValueText}" FontSize="14"
                     Visibility="{Binding Subtitle, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CardTemplate}" Focusable="False" />
    </StackPanel>
</UserControl>
