<Window x:Class="Unravel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Unravel.App.ViewModels"
        xmlns:views="clr-namespace:Unravel.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding AppTitle, FallbackValue=Unravel}" Icon="unravel.ico"
        Style="{StaticResource UnravelWindow}"
        Width="1240" Height="900" MinWidth="980" MinHeight="600"
        WindowStartupLocation="Manual">

    <Grid x:Name="Root" Background="{StaticResource Window}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================ sidebar (plan.md section 7) -->
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,20,12,16">
                <!-- logo + name, as in Unveil's header -->
                <Grid DockPanel.Dock="Top" Margin="6,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="unravel.png" Width="38" Height="38" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Unravel" Style="{StaticResource TitleText}" FontSize="21" />
                            <TextBlock Text="{Binding AppVersion}" Style="{StaticResource MutedText}" FontSize="12"
                                       VerticalAlignment="Bottom" Margin="6,0,0,4" ToolTip="Unravel version" />
                        </StackPanel>
                        <TextBlock Text="Everything about this PC." Style="{StaticResource MutedText}" FontSize="12" />
                    </StackPanel>
                </Grid>

                <TextBlock DockPanel.Dock="Bottom" Margin="8,0" Style="{StaticResource MutedText}" FontSize="12"
                           Text="Read-only. Nothing is sent anywhere." TextWrapping="Wrap" />

                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Summary}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE80F;" Margin="0,0,12,0" />
                            <TextBlock Text="Summary" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Device}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE7F8;" Margin="0,0,12,0" />
                            <TextBlock Text="Device" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Hardware}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE950;" Margin="0,0,12,0" />
                            <TextBlock Text="Hardware" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Os}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE770;" Margin="0,0,12,0" />
                            <TextBlock Text="OS" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Software}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE71D;" Margin="0,0,12,0" />
                            <TextBlock Text="Software" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Security}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE72E;" Margin="0,0,12,0" />
                            <TextBlock Text="Security" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Diagnostics}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE9D9;" Margin="0,0,12,0" />
                            <TextBlock Text="Diagnostics" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Reports}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8A5;" Margin="0,0,12,0" />
                            <TextBlock Text="Reports" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================ content -->
        <DockPanel Grid.Column="1">
            <!-- toolbar -->
            <Border DockPanel.Dock="Top" Padding="28,16,28,12">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" Margin="0,0,8,0"
                                    ToolTip="Looks for a newer Unravel on GitHub and, if you agree, downloads and installs it (checked against the release's checksums)" />
                            <Button Content="Rescan" Command="{Binding RescanCommand}" Margin="0,0,8,0"
                                    ToolTip="Read everything again" />
                            <Button Content="Run diagnostics" Command="{Binding RunDiagnosticsCommand}" Style="{StaticResource PrimaryButton}"
                                    ToolTip="Health checks, Windows 11 readiness, stability and the disk, network, memory and system file tests" />
                        </StackPanel>
                        <!-- needs-admin notice (plan.md section 7): in the top bar, so it takes no room on the page -->
                        <Button DockPanel.Dock="Right" Content="Restart as administrator" Command="{Binding RestartAsAdminCommand}" Margin="0,0,8,0"
                                ToolTip="BitLocker, TPM details, disk health (SMART), crash dumps and the system file test need administrator rights"
                                Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVis}}" />
                        <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="300" Margin="0,0,16,0" ToolTip="{Binding StatusText}" />
                        <DockPanel HorizontalAlignment="Right" Margin="0,0,10,0"
                                   Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVis}}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconText}" Text="&#xE7BA;" Foreground="{StaticResource Warning}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Style="{StaticResource BodyText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Text="Some details need administrator rights"
                                       ToolTip="Some details need administrator rights. Restart as administrator to include them." />
                        </DockPanel>
                    </DockPanel>
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="3" Margin="0,10,0,0"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="Page" Background="{StaticResource Window}" Margin="28,4,28,28">
                    <views:SummaryView Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVis}, ConverterParameter=Summary}" />
                    <views:PageView DataContext="{Binding DevicePage}"
                                    Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter=Device}" />
                    <views:PageView DataContext="{Binding HardwarePage}"
                                    Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter=Hardware}" />
                    <views:PageView DataContext="{Binding OsPage}"
                                    Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter=Os}" />
                    <views:SoftwareView Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVis}, ConverterParameter=Software}" />
                    <views:PageView DataContext="{Binding SecurityPage}"
                                    Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter=Security}" />
                    <views:DiagnosticsView Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVis}, ConverterParameter=Diagnostics}" />
                    <views:ReportsView Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVis}, ConverterParameter=Reports}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
