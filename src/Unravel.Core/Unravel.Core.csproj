<Project Sdk="Microsoft.NET.Sdk">

  <!-- Models, collectors and diagnostics. No UI code, so a CLI/RMM mode can reuse it. -->
  <PropertyGroup>
    <RootNamespace>Unravel.Core</RootNamespace>
    <!-- The disk speed test needs a sector-aligned native buffer for unbuffered I/O. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.15" />
    <!-- EventLogReader for the stability section (plan.md 5.2) -->
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows end-of-support dates; a lifecycle.json next to Unravel.exe overrides it. -->
    <EmbeddedResource Include="Diagnostics\lifecycle.json" LogicalName="Unravel.lifecycle.json" />
    <!-- The app logo, drawn into the HTML and PDF reports (assets/make_icon.py). -->
    <EmbeddedResource Include="..\..\assets\unravel.png" LogicalName="Unravel.logo.png" Link="Reports\unravel.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Unravel.Core.Tests" />
  </ItemGroup>

</Project>
